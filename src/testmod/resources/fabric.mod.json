{
  "schemaVersion": 1,
  "id": "${mod_id}_testmod",
  "version": "${mod_version}",
  "name": "${mod_name} Test Mod",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "org.teamvoided.voidlib.testmod.VTest"
      }
    ]
  },
  "mixins": [
    "voidlib_testmod.mixins.json"
  ],
  "depends": {
    "java": ">=${java}",
    "minecraft": "${version_range}",
    "fabricloader": "*",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin}",
    "fzzy_config": ">=${fzzy_config}"
  }
}