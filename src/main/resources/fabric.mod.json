{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [ "${authors}" ],
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "org.teamvoided.voidlib.Voidlib::init"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "org.teamvoided.voidlib.client.VoidlibClient::init"
      }
    ]
  },
  "mixins": [
    "voidlib.mixins.json",
    {
      "config": "voidlib.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "voidlib.classtweaker",
  "depends": {
    "java": ">=${java}",
    "minecraft": "${version_range}",
    "fabricloader": "*",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin}",
    "fzzy_config": ">=${fzzy_config}"
  },
  "contact": {
    "homepage": "https://github.com/${github_repo}",
    "issues": "https://github.com/${github_repo}/issues",
    "sources": "https://github.com/${github_repo}",
    "discord": "${discord_invite}"
  },
  "license": "${license}",
  "icon": "assets/voidlib/icon.png"
}